    {"from": "Fail2", "event": "pass_ok", "to": "TwoFA"},
    {"from": "Locked", "event": "admin_unlock", "to": "Start"},

    {"from": "EnterUser", "event": "cancel", "to": "Start"},
    {"from": "EnterPass", "event": "cancel", "to": "Start"},
    {"from": "Fail1", "event": "cancel", "to": "Start"},
    {"from": "Fail2", "event": "cancel", "to": "Start"},
    {"from": "TwoFA", "event": "cancel", "to": "Start"},

    {"from": "EnterUser", "event": "timeout", "to": "SessionExpired"},
    {"from": "EnterPass", "event": "timeout", "to": "SessionExpired"},
    {"from": "Fail1", "event": "timeout", "to": "SessionExpired"},
    {"from": "Fail2", "event": "timeout", "to": "SessionExpired"},
    {"from": "TwoFA", "event": "timeout", "to": "SessionExpired"},
    {"from": "SessionExpired", "event": "reconnect", "to": "Start"},

    {"from": "LoggedIn", "event": "logout", "to": "Start"},
    {"from": "Profile", "event": "logout", "to": "Start"},
    {"from": "ChangePass", "event": "logout", "to": "Start"}
