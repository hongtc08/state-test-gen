{
  "name": "login",
  "initial": "Start",
  "states": [
    "Start",
    "EnterUser",
    "EnterPass",
    "Fail1",
    "Fail2",
    "Locked",
    "TwoFA",
    "LoggedIn",
    "Profile",
    "ChangePass",
    "SessionExpired"
  ],
  "transitions": [
    {"from": "Start", "event": "input_user", "to": "EnterUser"},
    {"from": "EnterUser", "event": "user_ok", "to": "EnterPass"},
